# Copy to .env and fill in the first block. scripts/01-fabric-setup.sh fills in the Fabric block.

# --- you set these ---
# Name of an existing, running Fabric capacity (F2 is enough)
FABRIC_CAPACITY_NAME=
# Passwords for the local Neo4j containers and the alias keystore (any random strings)
NEO4J_PASSWORD=
KEYSTORE_PASSWORD=
# Neo4j Enterprise license: "yes" (commercial license) or "eval" (evaluation). See README.
NEO4J_ACCEPT_LICENSE_AGREEMENT=
# AuraDB instance for experiment 2 (from the credentials file Aura gives you).
# Newer instances use the instance id as user and database name; older ones use neo4j/neo4j.
AURA_URI=
AURA_USER=
AURA_PASSWORD=
AURA_DATABASE=

# --- written by scripts/01-fabric-setup.sh ---
FABRIC_WORKSPACE_ID=
FABRIC_WAREHOUSE_NAME=contracts_wh
FABRIC_SQL_ENDPOINT=
FABRIC_SP_CLIENT_ID=
FABRIC_SP_CLIENT_SECRET=

# --- optional overrides ---
# FABRIC_WORKSPACE_NAME=neo4j-vg-lab
# FABRIC_SP_NAME=neo4j-vg-lab-sp
# VG_HTTP_PORT=17474
# VG_BOLT_PORT=17687
# ROUTER_HTTP_PORT=27474
# ROUTER_BOLT_PORT=27687
